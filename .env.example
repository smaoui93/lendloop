# Next.js (.env.local) — `npx convex dev` fills in the CONVEX_* values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Convex deployment env vars — set with `npx convex env set NAME value`,
# NOT in this file (Convex functions don't read .env.local):
#   CLERK_JWT_ISSUER_DOMAIN   https://<your-app>.clerk.accounts.dev
#   ADMIN_EMAILS              comma-separated emails promoted to admin on sign-in
#   N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request
#   N8N_WEBHOOK_SECRET        shared with n8n LENDLOOP_WEBHOOK_SECRET
#   N8N_INBOUND_SECRET        shared with n8n LENDLOOP_INBOUND_SECRET
