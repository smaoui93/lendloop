# Copy to n8n/.env (gitignored). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Encrypts n8n credentials at rest. Keep it stable once set.
N8N_ENCRYPTION_KEY=

# Convex -> n8n: must equal Convex env N8N_WEBHOOK_SECRET
LENDLOOP_WEBHOOK_SECRET=

# n8n -> Convex: must equal Convex env N8N_INBOUND_SECRET (a different value!)
LENDLOOP_INBOUND_SECRET=

# Convex HTTP actions base URL (the *.convex.site URL, or the local one).
# Local Convex deployment from inside Docker:
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
# Cloud: LENDLOOP_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Optional: enables the disabled "Discord" nodes once you turn them on.
DISCORD_WEBHOOK_URL=
